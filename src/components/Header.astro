---
const current = Astro.url.pathname;
const links = [{ href: '/', label: '首页' }, { href: '/blog/', label: '文章' }, { href: '/about/', label: '关于' }];
---
<a class="skip-link" href="#main">跳到正文</a>
<header class="site-header">
  <a class="brand" href="/" aria-label="RobotX 首页"><span class="brand-icon" aria-hidden="true">R<span>ˣ</span></span><span>RobotX<span class="brand-dot">.</span></span></a>
  <nav aria-label="主导航">{links.map(({ href, label }) => <a href={href} aria-current={(href === '/' ? current === '/' : current.startsWith(href)) ? 'page' : undefined}>{label}</a>)}</nav>
</header>
